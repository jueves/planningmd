ACCESS_TOKEN=your-secret-access-token

TODOIST_FILTER="!#Home & today"
SUBTASK_DAYS=7

# Number of days ahead to include (starting from today)
ICAL_DAYS_AHEAD=7

# Network printer (IPP). Used by the /print endpoint.
# IPP URI of the printer. IPP Everywhere printers accept PDF directly,
# so no driver or CUPS server is required. Examples:
#   ipp://192.168.1.50:631/ipp/print
#   ipps://printer.local:631/ipp/print
PRINTER_URI=ipp://192.168.1.50:631/ipp/print
# Name attached to the print job (optional)
PRINTER_JOB_USER=planningmd

# Sensitive keys are stored in a different file
# This allows different management in the server
ENV_SENSTIVE=./.env.sensitive.example
