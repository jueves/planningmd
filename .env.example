ACCESS_TOKEN=your-secret-access-token

TODOIST_FILTER="!#Home & today"
SUBTASK_DAYS=7

# Number of days ahead to include (starting from today)
ICAL_DAYS_AHEAD=7

# Network printer via CUPS. Used by the /print endpoint.
# CUPS server host (or host:port; port defaults to 631/IPP).
# Leave empty to use the local CUPS instance.
CUPS_SERVER=192.168.1.10
# Name of the print queue on that CUPS server
PRINTER_NAME=my-printer

# Sensitive keys are stored in a different file
# This allows different management in the server
ENV_SENSTIVE=./.env.sensitive.example
